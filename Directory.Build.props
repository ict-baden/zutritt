<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte im Repo (Vorlage aus ict-baden/richtlinien) -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Company>ICT-Baden</Company>
    <Product>Zutritt</Product>
    <Copyright>© 2026 ICT-Baden</Copyright>
    <!-- Richtlinie 13: Texte in Zutritt.Core/Resources/Strings*.resx, Englisch ist die Rückfallsprache -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Nur Sprachressourcen der fünf Sprachen mitliefern (auch die fremder Pakete) -->
    <SatelliteResourceLanguages>en;de;es;fr;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
