<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plattformneutral: Windows-Eigenes (NTFS, Freigaben, Konten) steckt in Zutritt.Platform.Windows hinter
         Zutritt.Core.Platform.IScanPlatform. Auswertung, Vergleich, Speicher und Berichte laufen so auch unter Linux. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Zutritt.Core</RootNamespace>
    <Description>Scanner, Auswertung, Speicher und Berichte für Zutritt – ohne Oberfläche und ohne Systemaufrufe.</Description>
    <!-- Eine nur unter Windows verfügbare API darf hier nie wieder hineinrutschen -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Version)' == ''">
    <!-- Eine Versionsnummer für alle Teile (steht im Bericht und im Lauf): die Basisversion steht nur in
         src/Zutritt/Zutritt.csproj, CI-Builds setzen -p:Version für alle Projekte -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../Zutritt/Zutritt.csproj')), '(?&lt;=&lt;Version&gt;)[^&lt;]+'))</Version>
  </PropertyGroup>

  <!-- Texte für Oberfläche, Befehlszeile und Berichte (Richtlinie 13): Strings.resx = Englisch (Rückfallsprache),
       Strings.de.resx, Strings.es.resx, Strings.fr.resx, Strings.zh-Hans.resx. Die Klasse Zutritt.Core.Resources.Strings
       erzeugt der Build, keine Designer-Datei im Repo. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Zutritt.Core.Resources"
                      StronglyTypedClassName="Strings" StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs" PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- PDFsharp bringt 8.0.1 mit (bekannte Schwachstellen GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) – gepflegte Fassung erzwingen -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zutritt.Tests" />
    <InternalsVisibleTo Include="Zutritt.Platform.Windows" />
  </ItemGroup>
</Project>
