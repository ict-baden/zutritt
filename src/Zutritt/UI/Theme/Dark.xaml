<!-- Ergänzt Fluent.Dark.xaml um die wenigen Zutritt-eigenen Farben -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ControlOff" Color="#00000000"/>
    <SolidColorBrush x:Key="ControlOffStroke" Color="#9AFFFFFF"/>
    <SolidColorBrush x:Key="Knob" Color="#D0FFFFFF"/>

    <SolidColorBrush x:Key="SevHigh" Color="#FF99A4"/>
    <SolidColorBrush x:Key="SevHighBg" Color="#33FF5A6A"/>
    <SolidColorBrush x:Key="SevMedium" Color="#FFB46B"/>
    <SolidColorBrush x:Key="SevMediumBg" Color="#33FF8C1A"/>
    <SolidColorBrush x:Key="SevLow" Color="#F2D45C"/>
    <SolidColorBrush x:Key="SevLowBg" Color="#29F2D45C"/>
    <SolidColorBrush x:Key="SevInfo" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="SevInfoBg" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Good" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="GoodBg" Color="#266CCB5F"/>

    <!-- Kopfkarte (Verlauf im Produkt-Akzent Blau-Violett, dezent) -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#335B8CFF" Offset="0"/>
        <GradientStop Color="#1A8B5CF6" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
