<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Zutritt.UI">

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <ui:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
    <ui:BoolToVisibleConverter x:Key="BoolToVisible"/>

    <!-- Standard-Steuerelemente (Button, TextBox, CheckBox, DataGrid, TreeView …) stylt Fluent.
         Hier stehen nur Zutritt-eigene Stile (weitgehend von Vitrine übernommen); Farben kommen aus den Fluent-Schlüsseln.
         AccentButton, GhostButton, MultiLineBox und Table legt ThemeManager zur Laufzeit an (BasedOn Fluent). -->

    <!-- ========== Text ========== -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="2,22,0,8"/>
    </Style>
    <Style x:Key="BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <!-- Grauer Hinweis über leeren Eingabefeldern (WPF-TextBox kennt keinen Platzhalter) -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Margin" Value="12,6,12,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Zellen in Tabellen: einzeilig, abgeschnitten, voller Text als Tooltip -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
    </Style>
    <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- ========== Fokus ========== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                               Background="Transparent" TextWrapping="Wrap"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Schalter (CheckBox als ToggleSwitch, wie Vitrine) ========== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" Text="Aus" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" MinWidth="22" TextAlignment="Right"/>
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource ControlOff}"
                                    BorderBrush="{DynamicResource ControlOffStroke}" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Knob}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            <Setter TargetName="State" Property="Text" Value="Ein"/>
                            <!-- Ohne Animation fest verschoben, damit auch Screenshots den Endzustand zeigen -->
                            <Setter TargetName="Knob" Property="Margin" Value="24,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14"/>
                            <Setter TargetName="Knob" Property="Height" Value="14"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="Margin" Value="23,0,0,0"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Navigation links (wie Vitrine, plus Abzeichen) ========== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"/>
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        <Grid Margin="14,0,10,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Border x:Name="Badge" Grid.Column="2" CornerRadius="9" MinWidth="24" Height="18" Padding="6,0"
                                    Background="{DynamicResource SevInfoBg}">
                                <TextBlock x:Name="BadgeText" Text="{Binding (ui:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Nav.Badge" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ui:Nav.Badge" Value="">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ui:Nav.BadgeTone" Value="Hoch">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SevHighBg}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SevHigh}"/>
                        </Trigger>
                        <Trigger Property="ui:Nav.BadgeTone" Value="Mittel">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SevMediumBg}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SevMedium}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Filter-Chips ========== -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="9,4,11,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="15" Padding="{TemplateBinding Padding}" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kachel als Auswahl (Vergleich: Kategorie wählen) -->
    <Style x:Key="TileChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16,12"
                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Bd" Property="Padding" Value="15,11"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Karten ========== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HeroBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
    <!-- Kleine Kennzeichnung („deaktiviert“, „Vererbung unterbrochen“) -->
    <Style x:Key="TagBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- ========== Schwere ========== -->
    <Style TargetType="ui:SeverityPill">
        <Setter Property="Foreground" Value="{DynamicResource SevInfo}"/>
        <Setter Property="Background" Value="{DynamicResource SevInfoBg}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SeverityPill">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="7,2,9,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="T" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="12"
                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Compact" Value="True">
                            <Setter TargetName="T" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Bd" Property="Padding" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Severity" Value="Hoch">
                <Setter Property="Foreground" Value="{DynamicResource SevHigh}"/>
                <Setter Property="Background" Value="{DynamicResource SevHighBg}"/>
            </Trigger>
            <Trigger Property="Severity" Value="Mittel">
                <Setter Property="Foreground" Value="{DynamicResource SevMedium}"/>
                <Setter Property="Background" Value="{DynamicResource SevMediumBg}"/>
            </Trigger>
            <Trigger Property="Severity" Value="Niedrig">
                <Setter Property="Foreground" Value="{DynamicResource SevLow}"/>
                <Setter Property="Background" Value="{DynamicResource SevLowBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Kennzahl-Kachel ========== -->
    <Style TargetType="ui:StatTile">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:StatTile">
                    <Border Style="{StaticResource Card}" Margin="0" Padding="16,12">
                        <StackPanel>
                            <Grid Height="18" HorizontalAlignment="Left">
                                <TextBlock x:Name="Ic" Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="15"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Ellipse x:Name="Dot" Width="10" Height="10" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{TemplateBinding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Hoch">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevHigh}"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Mittel">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevMedium}"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Niedrig">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevLow}"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Info">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevInfo}"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Gut">
                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Good}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Einstellungszeile (wie Vitrine) ========== -->
    <Style TargetType="ui:SettingCard">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingCard">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" MinHeight="68">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="Ic" Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                       Margin="2,0,18,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Body}"/>
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ContentPresenter x:Name="CP" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Below">
                            <Setter TargetName="CP" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="CP" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="CP" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="CP" Property="Margin" Value="0,12,0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
