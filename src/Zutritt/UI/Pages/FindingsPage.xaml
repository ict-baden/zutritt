<UserControl x:Class="Zutritt.UI.Pages.FindingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <Grid Margin="36,0,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Filter ========== -->
        <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ChipHigh" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SeverityPill Severity="Hoch" Compact="True"/>
                        <TextBlock x:Name="ChipHighText" Text="Hoch" Margin="7,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipMedium" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SeverityPill Severity="Mittel" Compact="True"/>
                        <TextBlock x:Name="ChipMediumText" Text="Mittel" Margin="7,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipLow" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SeverityPill Severity="Niedrig" Compact="True"/>
                        <TextBlock x:Name="ChipLowText" Text="Niedrig" Margin="7,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipInfo" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SeverityPill Severity="Info" Compact="True"/>
                        <TextBlock x:Name="ChipInfoText" Text="Info" Margin="7,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <ComboBox x:Name="RuleFilter" Grid.Column="2" Width="200" Margin="12,0,8,0" VerticalAlignment="Center"
                      DisplayMemberPath="Label" SelectionChanged="RuleFilter_SelectionChanged" AutomationProperties.Name="Nach Regel filtern"/>
            <Grid Grid.Column="3" Width="200" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="Befunde durchsuchen" Padding="10,5,30,6"/>
                <TextBlock Style="{StaticResource Placeholder}" Text="Pfad, Konto oder Text"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <!-- ========== Liste ========== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <!-- Schlanke Tabelle statt DataGrid (siehe ListTable): beim Filtern von Tausenden Befunden wird jede
                     sichtbare Zeile neu angelegt -->
                <ListView x:Name="FindingsList" Style="{DynamicResource ListTable}" ui:ListTable.Columns="70, 1.75*:130, 1.35*:110, 0.9*:80"
                          SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"
                          GridViewColumnHeader.Click="Header_Click" AutomationProperties.Name="Befunde">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <!-- Ohne den Einzug, den WPF Gruppen standardmäßig gibt: Zeilen stehen bündig unter den Spaltenköpfen -->
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter/>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,12,0,4">
                                        <ui:SeverityPill Severity="{Binding Name}"/>
                                        <TextBlock Text="{Binding ItemCount, StringFormat={}{0:N0}, ConverterCulture=de-DE}" Style="{StaticResource Caption}" FontSize="13"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <!-- Schwere als Punkt vor der Regel: spart eine Spalte, die Gruppen nennen die Schwere ohnehin -->
                            <GridViewColumn x:Name="ColRule" Header="Regel" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding SeverityLabel}">
                                            <Ellipse Style="{StaticResource SeverityDot}"/>
                                            <TextBlock Text="{Binding RuleId}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColTitle" Header="Titel" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColPath" Header="Pfad" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:PathText Text="{Binding Path}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColAccount" Header="Konto" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccountName}" ToolTip="{Binding Account}" ToolTipService.InitialShowDelay="700"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="24">
                    <TextBlock x:Name="EmptyGlyph" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Good}"/>
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== Detail ========== -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Padding="20,18" Focusable="False">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SeverityPill x:Name="DetailSeverity"/>
                            <TextBlock x:Name="DetailRule" Style="{StaticResource Caption}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleText}" FontSize="18" Margin="0,10,0,0"/>
                        <TextBlock x:Name="DetailMessage" Style="{StaticResource Body}" Margin="0,6,0,0"/>

                        <TextBlock Text="Pfad" Style="{StaticResource Caption}" Margin="0,16,0,2"/>
                        <TextBox x:Name="DetailPath" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                 AutomationProperties.Name="Pfad des Befunds"/>
                        <StackPanel x:Name="DetailAccountPanel">
                            <TextBlock Text="Konto" Style="{StaticResource Caption}" Margin="0,10,0,2"/>
                            <TextBlock x:Name="DetailAccount" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="DetailAccountKind" Style="{StaticResource Caption}"/>
                        </StackPanel>

                        <TextBlock Text="Warum ist das wichtig?" Style="{StaticResource BodyStrong}" Margin="0,18,0,4"/>
                        <TextBlock x:Name="DetailExplanation" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Empfehlung" Style="{StaticResource BodyStrong}" Margin="0,14,0,4"/>
                        <TextBlock x:Name="DetailRecommendation" Style="{StaticResource Body}"/>

                        <Button x:Name="ShowFolderButton" Margin="0,20,0,0" Click="ShowFolder_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ordner anzeigen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="DetailEmpty" Style="{StaticResource Caption}" FontSize="13" Margin="24" TextAlignment="Center"
                           VerticalAlignment="Center" Text="Befund auswählen, um Erklärung und Empfehlung zu sehen."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
