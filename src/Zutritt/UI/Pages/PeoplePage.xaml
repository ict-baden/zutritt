<UserControl x:Class="Zutritt.UI.Pages.PeoplePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <Grid Margin="36,0,36,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Liste ========== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="Personen suchen" Padding="10,5,30,6"/>
                <TextBlock Style="{StaticResource Placeholder}" Text="Name oder Konto suchen"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,10,0,0">
                <Grid>
                    <ListBox x:Name="PeopleList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="PeopleList_SelectionChanged" AutomationProperties.Name="Personen">
                        <ListBox.Resources>
                            <!-- Fluent-Abstand etwas enger: mehr Personen auf einen Blick -->
                            <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" AutomationProperties.Name="{Binding DisplayName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSubtle}">
                                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Account}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FolderCountText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                        <Border Style="{StaticResource TagBorder}" Margin="0,2,0,0" Padding="5,0" HorizontalAlignment="Right"
                                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Text="deaktiviert" Style="{StaticResource TagText}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ListEmpty" Style="{StaticResource Caption}" FontSize="13" Margin="14" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <TextBlock x:Name="ListCaption" Grid.Row="2" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
        </Grid>

        <!-- ========== Detail ========== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" Margin="0">
            <Grid>
                <Grid x:Name="DetailRoot" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="DetailInitials" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleText}"/>
                            <TextBlock x:Name="DetailAccount" Style="{StaticResource Caption}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel x:Name="Facts" Grid.Row="1" Margin="0,12,0,0"/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="GroupsTitle" Text="Mitglied in" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Focusable="False">
                            <WrapPanel x:Name="Groups"/>
                        </ScrollViewer>
                        <TextBlock x:Name="AccessTitle" Text="Zugriff" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,14,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                   Text="Ordner mit eigenen Rechten – Unterordner ohne eigene Rechte erben davon."/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <ListView x:Name="AccessTable" Style="{DynamicResource ListTable}" ui:ListTable.Columns="3*:160, 96, 2*:100, 32"
                                  AutomationProperties.Name="Ordner, auf die die Person zugreifen darf">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="Pfad" ui:ListTable.SortBy="Path">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:PathText Text="{Binding Path}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Recht" ui:ListTable.SortBy="Level">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Right}" ToolTip="{Binding RightDetail}" ToolTipService.InitialShowDelay="700"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Über Gruppen" ui:ListTable.SortBy="Via">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Via}" ToolTip="{Binding ViaFull}" ToolTipService.InitialShowDelay="700"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource SevMedium}"
                                                       HorizontalAlignment="Left" ToolTip="{Binding Note}" AutomationProperties.Name="{Binding Note}"
                                                       Visibility="{Binding Note, Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="AccessStatus" Style="{StaticResource Caption}" FontSize="13" Margin="4,10" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="DetailEmpty" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"
                           Margin="24" Text="Person links auswählen, um zu sehen, wo sie überall hin darf."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
