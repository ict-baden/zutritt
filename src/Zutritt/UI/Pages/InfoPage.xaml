<UserControl x:Class="Zutritt.UI.Pages.InfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,30,28" Focusable="False">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Zutritt;component/Assets/zutritt.png" Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Zutritt" Style="{StaticResource SubtitleText}"/>
                        <TextBlock x:Name="VersionText" Text="Version 1.0.0" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Zeigt, wer auf Dateifreigaben worauf zugreifen darf – mit Befunden, Vergleich und Bericht."
                                   Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:SettingCard Glyph="&#xE8B7;" Header="Datenbank" x:Name="DatabaseCard" Description="%LocalAppData%\Zutritt\zutritt.db">
                <Button x:Name="DatabaseButton" Content="Ordner öffnen" Click="OpenDatabaseFolder_Click"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE7EF;" Header="Herausgeber" Description="ICT-Baden">
                <TextBlock/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8D7;" Header="Lizenz" Description="Die Lizenz ist noch nicht festgelegt.">
                <TextBlock/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE71B;" Header="Quellcode und Fragen" Description="github.com/ict-baden/zutritt">
                <Button Click="OpenRepository_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Im Browser öffnen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE72E;" Header="Nur lesend"
                            Description="Zutritt liest Freigaben, NTFS-Rechte und Gruppenmitgliedschaften. An Rechten, Dateien und Konten ändert es nichts.">
                <TextBlock/>
            </ui:SettingCard>

            <TextBlock Text="Befehlszeile und geplante Aufgaben" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Dieselbe Zutritt.exe läuft auch ohne Fenster – zum Beispiel jede Woche als geplante Aufgabe mit Bericht zum Abzeichnen:"/>
                    <TextBox x:Name="CommandExample" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                             AutomationProperties.Name="Beispiel für die Befehlszeile"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Exitcode 0" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Column="1" Text="keine Befunde ab „Mittel“" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="1" Text="Exitcode 1" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Befunde „Mittel“, aber keine „Hoch“" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="2" Text="Exitcode 2" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="mindestens ein Befund „Hoch“" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="3" Text="Exitcode 3" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Fehler oder Abbruch" Style="{StaticResource Body}" FontSize="13"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Alle Befehle und Optionen: Zutritt.exe --hilfe"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Tastatur" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,14">
                <TextBlock Style="{StaticResource Body}" FontSize="13" LineHeight="22"
                           Text="Strg+1 bis Strg+7 wechselt zwischen den Seiten · Strg+F springt ins Suchfeld · Eingabe öffnet den gewählten Lauf, Entf löscht ihn"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
