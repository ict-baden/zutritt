<UserControl x:Class="Zutritt.UI.Pages.InfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,30,28" Focusable="False">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Zutritt;component/Assets/zutritt.png" Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Zutritt" Style="{StaticResource SubtitleText}"/>
                        <TextBlock x:Name="VersionText" Text="" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Zeigt, wer auf Dateifreigaben worauf zugreifen darf – mit Befunden, Vergleich und Bericht."
                                   Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="CopyrightText" Text="" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:SettingCard Glyph="&#xE8B7;" Header="Datenbank" x:Name="DatabaseCard" Description="%LocalAppData%\Zutritt\zutritt.db">
                <Button x:Name="DatabaseButton" Click="OpenDatabaseFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Ordner öffnen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE72E;" Header="Nur lesend, Daten bleiben hier" x:Name="ReadOnlyCard"
                            Description="Zutritt liest Freigaben, NTFS-Rechte und Gruppenmitgliedschaften. An Rechten, Dateien und Konten ändert es nichts. Diese Software sendet keine Daten an ICT-Baden.">
                <TextBlock/>
            </ui:SettingCard>

            <TextBlock Text="Lizenz" Style="{StaticResource SectionText}"/>
            <ui:SettingCard Glyph="&#xE8D7;" Header="MIT-Lizenz" x:Name="LicenseCard"
                            Description="Freie Nutzung, Änderung und Weitergabe, solange Copyright und Lizenztext erhalten bleiben.">
                <Button x:Name="LicenseButton" Click="ShowLicense_Click" Content="Lizenztext anzeigen"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8F1;" Header="Drittanbieter-Lizenzen"
                            Description="Bibliotheken, die Zutritt mitbringt – mit Version, Quelle, Copyright und Lizenztext.">
                <Button x:Name="NoticesButton" Click="ShowNotices_Click" Content="Anzeigen"/>
            </ui:SettingCard>

            <TextBlock Text="Hilfe und Links" Style="{StaticResource SectionText}"/>
            <ui:SettingCard Glyph="&#xE897;" Header="Hilfe &amp; Support"
                            Description="Fehler melden und Fragen stellen über GitHub – verbindlich mit einem Supportvertrag.">
                <Button Click="OpenSupport_Click" Content="Öffnen" AutomationProperties.Name="Hilfe und Support öffnen"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE9D9;" Header="Diagnosepaket erstellen"
                            Description="Version, Systemangaben und Protokoll der letzten 7 Tage als ZIP für den Support.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ohne Namen und Adressen" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="AnonymizeDiagnostics" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                              Margin="0,0,16,0" AutomationProperties.Name="Diagnosepaket ohne Namen, Pfade und Adressen"/>
                    <Button Click="CreateDiagnostics_Click" Content="Erstellen …"/>
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE943;" Header="Quellcode (GitHub)" Description="github.com/ict-baden/zutritt">
                <Button Click="OpenRepository_Click" Content="Öffnen" AutomationProperties.Name="Quellcode auf GitHub öffnen"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8A1;" Header="Datenschutz"
                            Description="Welche Daten Zutritt wo speichert, welche Verbindungen es aufbaut und wie man alles löscht.">
                <Button Click="OpenPrivacy_Click" Content="Öffnen" AutomationProperties.Name="Datenschutz öffnen"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE779;" Header="Impressum" x:Name="ImpressumCard" Description="ICT-Baden">
                <Button Click="OpenImpressum_Click" Content="Öffnen" AutomationProperties.Name="Impressum öffnen"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE774;" Header="Webseite" Description="ICT-Baden auf GitHub">
                <Button Click="OpenWebsite_Click" Content="Öffnen" AutomationProperties.Name="Webseite öffnen"/>
            </ui:SettingCard>

            <TextBlock Text="Befehlszeile und geplante Aufgaben" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Dieselbe Zutritt.exe läuft auch ohne Fenster – zum Beispiel jede Woche als geplante Aufgabe mit Bericht zum Abzeichnen:"/>
                    <TextBox x:Name="CommandExample" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                             AutomationProperties.Name="Beispiel für die Befehlszeile"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Exitcode 0" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Column="1" Text="keine Befunde ab „Mittel“" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="1" Text="Exitcode 1" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Befunde „Mittel“, aber keine „Hoch“" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="2" Text="Exitcode 2" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="mindestens ein Befund „Hoch“" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="3" Text="Exitcode 3" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Fehler oder Abbruch" Style="{StaticResource Body}" FontSize="13"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Alle Befehle und Optionen: Zutritt.exe --hilfe · Version und diese Angaben als Text: Zutritt.exe --info"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Tastatur" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,14">
                <TextBlock Style="{StaticResource Body}" FontSize="13" LineHeight="22"
                           Text="Strg+1 bis Strg+7 wechselt zwischen den Seiten · Strg+F springt ins Suchfeld · Eingabe öffnet den gewählten Lauf, Entf löscht ihn"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
