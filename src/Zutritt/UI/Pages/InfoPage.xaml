<UserControl x:Class="Zutritt.UI.Pages.InfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Zutritt.Core.Resources;assembly=Zutritt.Core"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,30,28" Focusable="False">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Zutritt;component/Assets/zutritt.png" Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Zutritt" Style="{StaticResource SubtitleText}"/>
                        <TextBlock x:Name="VersionText" Text="" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{x:Static res:Strings.App_Tagline}"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="CopyrightText" Text="" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:SettingCard Glyph="&#xE8B7;" Header="{x:Static res:Strings.Cli_InfoDatabase}" x:Name="DatabaseCard" Description="%LocalAppData%\Zutritt\zutritt.db">
                <Button x:Name="DatabaseButton" Click="OpenDatabaseFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.Info_OpenFolder}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE72E;" Header="{x:Static res:Strings.Info_ReadOnlyHeader}" x:Name="ReadOnlyCard"
                            Description="">
                <TextBlock/>
            </ui:SettingCard>

            <ui:SettingCard Glyph="&#xE8C1;" Header="{x:Static res:Strings.Cli_InfoLanguage}" x:Name="LanguageCard"
                            Description="{x:Static res:Strings.Info_LanguageDescription}">
                <ComboBox x:Name="LanguageBox" MinWidth="200" DisplayMemberPath="Name" SelectionChanged="Language_SelectionChanged"
                          AutomationProperties.Name="{x:Static res:Strings.Cli_InfoLanguage}"/>
            </ui:SettingCard>

            <TextBlock Text="{x:Static res:Strings.Info_License}" Style="{StaticResource SectionText}"/>
            <ui:SettingCard Glyph="&#xE8D7;" Header="{x:Static res:Strings.App_LicenseName}" x:Name="LicenseCard"
                            Description="{x:Static res:Strings.Info_LicenseDescription}">
                <Button x:Name="LicenseButton" Click="ShowLicense_Click" Content="{x:Static res:Strings.Info_ShowLicense}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8F1;" Header="{x:Static res:Strings.Cli_InfoNotices}"
                            Description="{x:Static res:Strings.Info_NoticesDescription}">
                <Button x:Name="NoticesButton" Click="ShowNotices_Click" Content="{x:Static res:Strings.Info_Show}"/>
            </ui:SettingCard>

            <TextBlock Text="{x:Static res:Strings.Info_HelpLinks}" Style="{StaticResource SectionText}"/>
            <ui:SettingCard Glyph="&#xE897;" Header="{x:Static res:Strings.Cli_InfoSupport}"
                            Description="{x:Static res:Strings.Info_SupportDescription}">
                <Button Click="OpenSupport_Click" Content="{x:Static res:Strings.Ui_Open}" AutomationProperties.Name="{x:Static res:Strings.Info_OpenSupport}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE9D9;" Header="{x:Static res:Strings.Info_Diagnostics}"
                            Description="{x:Static res:Strings.Info_DiagnosticsDescription}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.Info_Anonymize}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="AnonymizeDiagnostics" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                              Margin="0,0,16,0" AutomationProperties.Name="{x:Static res:Strings.Info_AnonymizeName}"/>
                    <Button Click="CreateDiagnostics_Click" Content="{x:Static res:Strings.Info_Create}"/>
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE943;" Header="{x:Static res:Strings.Cli_InfoSource}" Description="github.com/ict-baden/zutritt">
                <Button Click="OpenRepository_Click" Content="{x:Static res:Strings.Ui_Open}" AutomationProperties.Name="{x:Static res:Strings.Info_OpenSource}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8A1;" Header="{x:Static res:Strings.Cli_InfoPrivacy}"
                            Description="{x:Static res:Strings.Info_PrivacyDescription}">
                <Button Click="OpenPrivacy_Click" Content="{x:Static res:Strings.Ui_Open}" AutomationProperties.Name="{x:Static res:Strings.Info_OpenPrivacy}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE779;" Header="{x:Static res:Strings.Cli_InfoImprint}" x:Name="ImpressumCard" Description="ICT-Baden">
                <Button Click="OpenImpressum_Click" Content="{x:Static res:Strings.Ui_Open}" AutomationProperties.Name="{x:Static res:Strings.Info_OpenImprint}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE774;" Header="{x:Static res:Strings.Cli_InfoWebsite}" Description="{x:Static res:Strings.Info_WebsiteDescription}">
                <Button Click="OpenWebsite_Click" Content="{x:Static res:Strings.Ui_Open}" AutomationProperties.Name="{x:Static res:Strings.Info_OpenWebsite}"/>
            </ui:SettingCard>

            <TextBlock Text="{x:Static res:Strings.Info_CliHeading}" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{x:Static res:Strings.Info_CliIntro}"/>
                    <TextBox x:Name="CommandExample" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                             AutomationProperties.Name="{x:Static res:Strings.Info_CliExampleName}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static res:Strings.Info_ExitCode0}" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Cli_ExitClean}" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Info_ExitCode1}" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.Info_ExitMediumLong}" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Info_ExitCode2}" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static res:Strings.Cli_ExitHigh}" Style="{StaticResource Body}" FontSize="13"/>
                        <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Info_ExitCode3}" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static res:Strings.Info_ExitError}" Style="{StaticResource Body}" FontSize="13"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="{x:Static res:Strings.Info_CliMore}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static res:Strings.Info_Keyboard}" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,14">
                <TextBlock Style="{StaticResource Body}" FontSize="13" LineHeight="22"
                           Text="{x:Static res:Strings.Info_KeyboardText}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
