<UserControl x:Class="Zutritt.UI.Pages.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,30,28" Focusable="False">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
            <Border x:Name="Hero" Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="28" Margin="0,2,18,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HeroTitle" Style="{StaticResource SubtitleText}" Text="Bericht zum geladenen Lauf"/>
                        <TextBlock x:Name="HeroText" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="HeroFile" Style="{StaticResource Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Bericht speichern" Style="{StaticResource SectionText}"/>
            <ui:SettingCard Glyph="&#xE9F9;" Header="Excel-Bericht"
                            Description="Zum Weiterarbeiten: Übersicht, Befunde, Ordner &amp; Rechte, Personen, Gruppen, Freigaben und – mit Vergleich – Änderungen, jeweils mit Filtern.">
                <Button x:Name="ExcelButton" Click="Excel_Click" MinWidth="220">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Excel-Bericht speichern …" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8A5;" Header="PDF-Bericht"
                            Description="Zum Ablegen und Abzeichnen: Deckblatt, Zusammenfassung, Befunde, Freigaben, Ordner mit eigenen Rechten, Personen und Abzeichnen-Block.">
                <Button x:Name="PdfButton" Style="{DynamicResource AccentButton}" Click="Pdf_Click" MinWidth="220">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="PDF-Bericht speichern …" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard x:Name="ChangesCard" Glyph="&#xE895;" Header="Änderungen seit dem letzten Lauf aufnehmen"
                            Description="Neue und behobene Befunde, geänderte Rechte und Mitgliedschaften als eigener Abschnitt.">
                <CheckBox x:Name="IncludeChanges" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                          AutomationProperties.Name="Änderungen seit dem letzten Lauf aufnehmen"/>
            </ui:SettingCard>

            <!-- Ergebnis -->
            <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,8,0,4" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Margin="2,0,16,0"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource BodyStrong}"/>
                        <ui:PathText x:Name="ResultPath" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel x:Name="ResultButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Öffnen" Click="OpenResult_Click" Margin="0,0,8,0"/>
                        <Button Content="Im Ordner zeigen" Click="ShowResult_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Abzeichnen" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}"
                                   Text="Am Ende des PDF-Berichts steht ein Abzeichnen-Block mit „Geprüft von“, „Datum“, „Unterschrift“ und „Bemerkungen“."/>
                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"
                                   Text="Ausgedruckt und unterschrieben – oder mit elektronischer Unterschrift im PDF – belegt er die regelmäßige Überprüfung der Zugriffsrechte, wie sie Audits nach GMP (Annex 11), ISO 27001 (A.5.18) oder NIS2 erwarten. Unter „Bemerkungen“ gehört, welche Befunde bewusst so bleiben und warum."/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   Text="Regelmäßig und ohne Klicken: als geplante Aufgabe mit „Zutritt.exe scan … &#x2011;&#x2011;vergleich &#x2011;&#x2011;bericht …“ (siehe Info)."/>
                    </StackPanel>
                    <!-- Skizze des Blocks -->
                    <Border Grid.Column="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12"
                            Background="{DynamicResource LayerFillColorDefaultBrush}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Abzeichnen" Style="{StaticResource BodyStrong}" FontSize="12"/>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Geprüft von" Style="{StaticResource Caption}" FontSize="11"/>
                                <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" BorderThickness="0,0,0,1" Margin="80,0,0,2"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Datum" Style="{StaticResource Caption}" FontSize="11"/>
                                <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" BorderThickness="0,0,0,1" Margin="80,0,0,2"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Unterschrift" Style="{StaticResource Caption}" FontSize="11"/>
                                <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" BorderThickness="0,0,0,1" Margin="80,0,0,2"/>
                            </Grid>
                            <TextBlock Text="Bemerkungen" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0"/>
                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" BorderThickness="0,0,0,1" Height="16"/>
                            <Border BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" BorderThickness="0,0,0,1" Height="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
