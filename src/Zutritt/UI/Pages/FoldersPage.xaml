<UserControl x:Class="Zutritt.UI.Pages.FoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Zutritt.Core.Resources;assembly=Zutritt.Core"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <Grid Margin="36,0,36,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Baum ========== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="{x:Static res:Strings.Fo_Search}" Padding="10,5,30,6"/>
                <TextBlock Style="{StaticResource Placeholder}" Text="{x:Static res:Strings.Fo_Search}"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4,6" Margin="0,10,0,0">
                <Grid>
                    <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.CacheLength="0.5" VirtualizingPanel.CacheLengthUnit="Page"
                              SelectedItemChanged="Tree_SelectedItemChanged" AutomationProperties.Name="{x:Static res:Strings.Fo_Tree}">
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1" Background="Transparent" ToolTip="{Binding Path}"
                                            AutomationProperties.Name="{Binding Name}">
                                    <TextBlock x:Name="Ic" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Broken" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" ToolTip="{x:Static res:Strings.Pdf_InheritanceBroken}"/>
                                    <TextBlock x:Name="Differs" Text="&#xE8DE;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                                               ToolTip="{x:Static res:Strings.Fo_DiffersTip}"/>
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                             ToolTip="{x:Static res:Strings.Fo_HasFinding}"/>
                                    <TextBlock x:Name="Err" Text="&#xE783;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" ToolTip="{x:Static res:Strings.Fo_NotReadableCap}"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsIntermediate}" Value="True">
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTop}" Value="True">
                                        <Setter TargetName="Ic" Property="Text" Value="&#xE8CE;"/>
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                        <Setter TargetName="Ic" Property="Text" Value="&#xE7C3;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InheritanceBroken}" Value="True">
                                        <Setter TargetName="Broken" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InheritanceDiffers}" Value="True">
                                        <Setter TargetName="Differs" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter TargetName="Err" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FindingTone}" Value="Hoch">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevHigh}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FindingTone}" Value="Mittel">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevMedium}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FindingTone}" Value="Niedrig">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevLow}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FindingTone}" Value="Info">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevInfo}"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <ListBox x:Name="SearchResults" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="SearchResults_SelectionChanged" AutomationProperties.Name="{x:Static res:Strings.Fo_SearchResults}">
                        <ListBox.Resources>
                            <Thickness x:Key="ListBoxItemPadding">10,5,10,5</Thickness>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <ui:PathText Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="TreeEmpty" Style="{StaticResource Caption}" FontSize="13" Margin="14" TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <WrapPanel Grid.Row="2" Margin="2,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static res:Strings.Pdf_InheritanceBroken}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="&#xE8DE;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static res:Strings.Excel_ColInheritanceDiffers}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SevHigh}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Col_Finding}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,5,0"/>
                    <TextBlock Text="{x:Static res:Strings.Report_NotReadable}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fo_GreyLegend}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>

        <!-- ========== Detail ========== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" Margin="0">
            <Grid>
                <Grid x:Name="DetailRoot" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleText}"/>
                        <TextBox x:Name="DetailPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0" MinHeight="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{x:Static res:Strings.Col_Path}"/>
                    </StackPanel>
                    <WrapPanel x:Name="Facts" Grid.Row="1" Margin="0,12,0,0"/>

                    <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,10,0,0">
                        <TabItem x:Name="TabAces" Header="{x:Static res:Strings.Fo_Entries}">
                            <DataGrid x:Name="AcesGrid" Style="{DynamicResource Table}" Margin="0,8,0,0"
                                      AutomationProperties.Name="{x:Static res:Strings.Fo_AclEntries}">
                                <DataGrid.Columns>
                                    <!-- Kurzname wie in den Befunden („Vertrieb-Leitung“ statt „KONZERN\Vertrieb-…“), der volle Name im Tooltip -->
                                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Account}" SortMemberPath="AccountName" Width="1.5*" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AccountName}" ToolTip="{Binding Account}" ToolTipService.InitialShowDelay="700"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{x:Static res:Strings.Col_AccountKind}" Binding="{Binding Kind}" Width="120" MinWidth="120" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Right}" SortMemberPath="Level" Width="*" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="T" Text="{Binding Right}" Style="{StaticResource CellText}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeny}" Value="True">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SevHigh}"/>
                                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{x:Static res:Strings.Fo_Origin}" Binding="{Binding Origin}" Width="84" MinWidth="84" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.Col_AppliesTo}" Binding="{Binding AppliesTo}" Width="1.3*" MinWidth="100" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="TabPeople" Header="{x:Static res:Strings.Fo_WhoCanEnter}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="BroadNotice" CornerRadius="6" Padding="12,9" Margin="0,0,0,8" Visibility="Collapsed"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                        <TextBlock x:Name="BroadText" Grid.Column="1" Style="{StaticResource Body}" FontSize="13"/>
                                    </Grid>
                                </Border>
                                <ListView x:Name="PeopleTable" Grid.Row="1" Style="{DynamicResource ListTable}" ui:ListTable.Columns="2*:140, 96, 96, 2*:110, 32"
                                          AutomationProperties.Name="{x:Static res:Strings.Excel_PeopleWithAccess}">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="{x:Static res:Strings.Col_Person}" ui:ListTable.SortBy="Person">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Person}" ToolTip="{Binding Account}" ToolTipService.InitialShowDelay="700"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{x:Static res:Strings.Col_Share}" ui:ListTable.SortBy="EffectiveLevel">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ViaShare}" Style="{StaticResource CellText}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="NTFS" ui:ListTable.SortBy="NtfsLevel">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Ntfs}" Style="{StaticResource CellText}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{x:Static res:Strings.Col_ViaGroups}" ui:ListTable.SortBy="Via">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Via}" ToolTip="{Binding ViaFull}" ToolTipService.InitialShowDelay="700"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource SevMedium}"
                                                               HorizontalAlignment="Left" ToolTip="{Binding Note}" AutomationProperties.Name="{Binding Note}"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="PeopleStatus" Grid.Row="1" Style="{StaticResource Caption}" FontSize="13" Margin="4,10" Visibility="Collapsed"/>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="TabFindings" Header="{x:Static res:Strings.Col_Findings}">
                            <Grid Margin="0,8,0,0">
                                <DataGrid x:Name="FindingsGrid" Style="{DynamicResource Table}" AutomationProperties.Name="{x:Static res:Strings.Fo_FolderFindings}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{x:Static res:Strings.Col_Severity}" SortMemberPath="Severity" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:SeverityPill Severity="{Binding Severity}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Rule}" Binding="{Binding RuleId}" Width="64" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Finding}" Binding="{Binding Message}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="FindingsEmpty" Style="{StaticResource Caption}" FontSize="13" Margin="4,10" Visibility="Collapsed"
                                           Text="{x:Static res:Strings.Fo_NoFindings}"/>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Zwischenebene ohne eigene Rechte -->
                    <StackPanel x:Name="InheritedPanel" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="InheritedText" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="ParentButton" Click="Parent_Click" Margin="0,14,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.Fo_ShowParent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="DetailEmpty" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"
                           Margin="24" Text="{x:Static res:Strings.Fo_SelectFolder}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
