<UserControl x:Class="Zutritt.UI.Pages.ComparisonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Zutritt.UI">
    <Grid Margin="36,0,36,20">
        <Grid x:Name="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== Auswahl des älteren Laufs ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OlderLabel" Text="Verglichen mit" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="OlderBox" Grid.Column="1" Width="460" DisplayMemberPath="Label" SelectionChanged="OlderBox_SelectionChanged"
                          AutomationProperties.LabeledBy="{Binding ElementName=OlderLabel}"/>
                <TextBlock x:Name="CompareInfo" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Grid>
            <Border x:Name="TargetsWarning" Grid.Row="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    <TextBlock x:Name="TargetsWarningText" Style="{StaticResource Body}" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ========== Kacheln ========== -->
            <UniformGrid x:Name="Tiles" Grid.Row="2" Columns="5" Margin="-4,12,-4,8">
                <RadioButton x:Name="TileNew" Style="{StaticResource TileChoice}" GroupName="cmp" Checked="Tile_Checked">
                    <StackPanel>
                        <ui:SeverityPill Severity="Hoch" Compact="True" HorizontalAlignment="Left" Height="18"/>
                        <TextBlock x:Name="CountNew" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Neue Befunde" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TileResolved" Style="{StaticResource TileChoice}" GroupName="cmp" Checked="Tile_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Height="18" HorizontalAlignment="Left" Foreground="{DynamicResource Good}"/>
                        <TextBlock x:Name="CountResolved" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Behobene Befunde" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TileAccess" Style="{StaticResource TileChoice}" GroupName="cmp" Checked="Tile_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="14" Height="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CountAccess" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Zugriffsänderungen" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TileAces" Style="{StaticResource TileChoice}" GroupName="cmp" Checked="Tile_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="14" Height="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CountAces" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="ACL-Änderungen" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TileMembers" Style="{StaticResource TileChoice}" GroupName="cmp" Checked="Tile_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE902;" Style="{StaticResource Icon}" FontSize="14" Height="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CountMembers" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Mitgliedschaften" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- ========== Liste zur gewählten Kachel ========== -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <DataGrid x:Name="FindingsGrid" Style="{DynamicResource Table}" Sorting="Grid_Sorting" AutomationProperties.Name="Befunde">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Schwere" SortMemberPath="Severity" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SeverityPill Severity="{Binding Severity}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Regel" Binding="{Binding RuleId}" Width="64" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Pfad" SortMemberPath="Path" Width="3*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:PathText Text="{Binding Path}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Account}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Befund" Binding="{Binding Message}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="AccessGrid" Style="{DynamicResource Table}" Sorting="Grid_Sorting" AutomationProperties.Name="Zugriffsänderungen" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Person" SortMemberPath="Person" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Person}" ToolTip="{Binding Account}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Pfad" SortMemberPath="Path" Width="3*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:PathText Text="{Binding Path}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Vorher" Binding="{Binding Before}" SortMemberPath="BeforeLevel" Width="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Nachher" Binding="{Binding After}" SortMemberPath="AfterLevel" Width="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Richtung" SortMemberPath="Direction" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="Arrow" Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource SevMedium}"/>
                                            <TextBlock x:Name="Word" Text="mehr Rechte" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMore}" Value="False">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#xE74B;"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Good}"/>
                                                <Setter TargetName="Word" Property="Text" Value="weniger Rechte"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="AcesGrid" Style="{DynamicResource Table}" Sorting="Grid_Sorting" AutomationProperties.Name="ACL-Änderungen" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Änderung" Binding="{Binding Change}" Width="150" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="Pfad" SortMemberPath="Path" Width="3*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:PathText Text="{Binding Path}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Account}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Vorher" Binding="{Binding Before}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Nachher" Binding="{Binding After}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="MembersGrid" Style="{DynamicResource Table}" Sorting="Grid_Sorting" AutomationProperties.Name="Geänderte Mitgliedschaften" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Änderung" Binding="{Binding Change}" Width="140" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Gruppe" Binding="{Binding Group}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Mitglied" Binding="{Binding Member}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ListEmpty" Style="{StaticResource Caption}" FontSize="13" Margin="16,14" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== Kein Vergleich möglich ========== -->
        <Border x:Name="NoComparison" Style="{StaticResource HeroCard}" VerticalAlignment="Top" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="NoComparisonTitle" Style="{StaticResource SubtitleText}"/>
                <TextBlock x:Name="NoComparisonText" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
