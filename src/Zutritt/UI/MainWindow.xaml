<Window x:Class="Zutritt.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Zutritt.UI"
        Title="Zutritt" Width="1200" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Zutritt;component/Assets/zutritt.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation ===================== -->
        <DockPanel Margin="12,12,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,20">
                <Image Source="pack://application:,,,/Zutritt;component/Assets/zutritt.png" Width="34" Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Zutritt" Style="{StaticResource BodyStrong}" FontSize="16"/>
                    <TextBlock Text="Wer darf wohin?" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Geladener Lauf -->
            <Border DockPanel.Dock="Top" Margin="4,0,4,14" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusCircle" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="StatusGlyph" Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Kein Lauf geladen" Style="{StaticResource BodyStrong}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="StatusDetail" Text="Scan starten oder Lauf öffnen" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <RadioButton x:Name="NavInfo" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="Info" Checked="Nav_Checked"/>
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Übersicht" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavFindings" Style="{StaticResource NavItem}" Tag="&#xE7BA;" Content="Befunde" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavFolders" Style="{StaticResource NavItem}" Tag="&#xE8B7;" Content="Ordner" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPeople" Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Personen" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavCompare" Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Vergleich" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavReport" Style="{StaticResource NavItem}" Tag="&#xE8A5;" Content="Bericht" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- ===================== Inhalt ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="36,26,36,12">
                <TextBlock x:Name="PageTitle" Text="Übersicht" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="1,2,0,0"/>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" IsTabStop="False"/>

            <!-- ===================== Meldungen (Fußleiste wie Vitrine) ===================== -->
            <Border x:Name="InfoBar" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0" Padding="36,10,24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InfoIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top" Padding="0,2,0,0"/>
                    <TextBlock x:Name="InfoText" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Click="CloseInfo_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                            ToolTip="Meldung schließen" AutomationProperties.Name="Meldung schließen">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
