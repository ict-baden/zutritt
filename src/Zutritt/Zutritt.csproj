<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows ohne Windows-SDK-Version: Zutritt nutzt keine WinRT-API, so kommt Microsoft.Windows.SDK.NET.dll
         (Lizenz des Windows SDK, nicht MIT) nicht in die Pakete. Mindestens Windows 10 1809 / Server 2019 bleibt Vorgabe
         (docs/installation.md, app.manifest); SupportedOSPlatformVersion 10.0.17763 ginge nur mit SDK-Version (NETSDK1135). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <RootNamespace>Zutritt</RootNamespace>
    <AssemblyName>Zutritt</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\zutritt.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Description>Zeigt, wer auf Dateifreigaben worauf zugreifen darf – mit Befunden, Vergleich und Bericht</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Eigener Einstiegspunkt (Program.Main): Befehlszeile ganz ohne WPF, sonst Oberfläche.
         App.xaml wird deshalb als normale Seite übersetzt, nicht als ApplicationDefinition mit eigenem Main. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zutritt.Core\Zutritt.Core.csproj" />
    <!-- Zutritt ist an Windows gebunden (NTFS-Rechte, SMB-Freigaben, AD); das Windows-Eigene steckt hier -->
    <ProjectReference Include="..\Zutritt.Platform.Windows\Zutritt.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zutritt.ico" />
    <Resource Include="Assets\zutritt.png" />
  </ItemGroup>

  <!-- Lizenztexte: neben der Exe (ZIP, MSI) und eingebettet für die Info-Seite
       (die einzelne Exe zum Herunterladen hat keine Dateien daneben) -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zutritt.Tests" />
  </ItemGroup>
</Project>
