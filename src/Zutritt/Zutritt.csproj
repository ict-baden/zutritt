<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zutritt</RootNamespace>
    <AssemblyName>Zutritt</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\zutritt.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>ICT-Baden</Company>
    <Product>Zutritt</Product>
    <Description>Zeigt, wer auf Dateifreigaben worauf zugreifen darf – mit Befunden, Vergleich und Bericht</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zutritt.Core\Zutritt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zutritt.ico" />
    <Resource Include="Assets\zutritt.png" />
  </ItemGroup>
</Project>
