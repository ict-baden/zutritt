<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-Ziel: alle Tests (Core, Windows-Anbindung mit echten Ordnern, Freigaben und Konten, App).
         net10.0: nur die plattformneutralen Core-Tests, die auch unter Linux laufen (ohne Windows/**). -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <!-- auch unter Linux wiederherstellbar (das Windows-Ziel wird dort nur nicht ausgeführt) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zutritt.Core\Zutritt.Core.csproj" />
  </ItemGroup>

  <!-- Nur unter Windows: Windows-Anbindung (NTFS, Freigaben, Konten) und die WPF-App (Info, Befehlszeile, Demo-Daten) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\..\src\Zutritt.Platform.Windows\Zutritt.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\Zutritt\Zutritt.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Windows\**" />
  </ItemGroup>
</Project>
