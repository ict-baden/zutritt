<Project>
  <!--
    PDFsharp 6.2.4 bringt drei Bibliotheken mit, die Zutritt nicht nutzt und nicht ausliefern soll (wie in Riegel):
    - PdfSharp.WPFonts.dll enthält sechs Segoe-WP-Schriften von Microsoft – ein Recht zur Weitergabe ist nicht geklärt;
    - PdfSharp.Snippets.dll und PdfSharp.Quality.dll sind Beispiel- und Prüfcode und die einzigen, die WPFonts verwenden.
    Sie werden nach dem Auflösen der Paketdateien entfernt, bevor deps.json und die Ausgabe entstehen (Build, Publish,
    Einzeldatei, MSI). Der PDF-Bericht nutzt die Schriften des Systems (PdfFonts). ThirdPartyNoticesTests prüft das an
    der deps.json, die CI an der ausgelieferten Ausgabe.
  -->
  <Target Name="ZutrittOhnePdfSharpZusatzbibliotheken" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
                             Condition="'%(Filename)' == 'PdfSharp.WPFonts' or '%(Filename)' == 'PdfSharp.Snippets' or '%(Filename)' == 'PdfSharp.Quality'" />
      <RuntimePackAsset Remove="@(RuntimePackAsset)"
                        Condition="'%(Filename)' == 'PdfSharp.WPFonts' or '%(Filename)' == 'PdfSharp.Snippets' or '%(Filename)' == 'PdfSharp.Quality'" />
    </ItemGroup>
  </Target>
</Project>
